{
  "manifest_version": 3,
  "name": "Deep File Downloader",
  "version": "1.0",
  "description": "Download linked files from the current page and pages linked 1 level deep.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
