{
  "manifest_version": 3,
  "name": "Linked File Downloader (1-level)",
  "version": "0.1.0",
  "description": "Download all linked files from the current page and from pages linked by it (one level deep).",
  "action": {
    "default_title": "Download linked files",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["downloads", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
